{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusNook",
  "version": "0.1.15",
  "identifier": "com.proanima.focusnook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FocusNook",
        "width": 380,
        "height": 484,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 280,
        "minHeight": 260,
        "maxWidth": 520,
        "maxHeight": 1200,
        "skipTaskbar": true,
        "zoomHotkeysEnabled": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/preserve-app-data.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
