# Генерируемые файлы пишутся инструментами с LF (vitest-снапшоты, tauri-plugin
# permissions). Без явного eol=lf на Windows с core.autocrlf=true они после каждой
# сборки/прогона тестов выглядят изменёнными, хотя содержимое то же.
*.snap text eol=lf
plugins/*/permissions/autogenerated/** text eol=lf
plugins/*/permissions/schemas/** text eol=lf
